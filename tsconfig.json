{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@sudobility/writing_core": ["../writing_core/src/index.ts"],
      "@sudobility/writing_formats/fountain-classify": ["../writing_formats/src/fountain/classify.ts"],
      "yjs": ["../writing_core/node_modules/yjs/dist/yjs", "../writing_core/node_modules/yjs"],
      "lib0": ["../writing_core/node_modules/lib0"],
      "lib0/*": ["../writing_core/node_modules/lib0/*"]
    }
  },
  "include": ["src", "demo", "tests", "vitest.config.ts"]
}
